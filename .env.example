# ─────────────────────────────────────────────────────────────
# IRIS Ticketing Platform — copy to .env and adjust
#   cp .env.example .env
# Every service validates these at boot and refuses to start if
# one is missing (see /SKILLS.md §3.3 — fail fast, loudly).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Postgres ────────────────────────────────────────────────
# Runs as the `iris-postgres` container (pgvector/pgvector) on 5432.
# NOTE: the machine's native Windows PostgreSQL 18 sits on 5433 and is
# deliberately NOT used by this project.
#
# iris_app is a NON-OWNER role — this is load-bearing. Postgres table
# owners bypass RLS, so connecting as the owner would silently disable
# every isolation policy. See docs/adr/004-isolation-row-level-security.md
CORE_DATABASE_URL=postgres://iris_app:iris_app_dev_pw@localhost:5432/iris
MIGRATOR_DATABASE_URL=postgres://iris_migrator:iris_migrator_dev_pw@localhost:5432/iris

# ── Redis (optional) ────────────────────────────────────────
# Ours runs on 6380; 6379 is occupied by an unrelated container.
# If unreachable the gateway falls back to an in-memory rate limiter.
REDIS_URL=redis://localhost:6380

# ── Ports ───────────────────────────────────────────────────
GATEWAY_PORT=4000
CORE_PORT=4100

# ── Service wiring ──────────────────────────────────────────
CORE_SERVICE_URL=http://localhost:4100
# Shared secret for gateway → core-service internal calls.
# core-service is never publicly bound, but this stops anything else
# on the host from calling it directly.
INTERNAL_API_KEY=dev_internal_key_change_me
PUBLIC_BASE_URL=http://localhost:4000

# ── Admin portal secrets ────────────────────────────────────────
# Signs support-user sessions. Change for anything non-local.
SESSION_SECRET=dev_session_secret_change_me_please

# Encrypts product client/webhook secrets at rest (AES-256-GCM).
# HMAC is symmetric — verifying an inbound signature and signing an outbound
# callback both need the secret itself, which a hash cannot provide.
# Rotating this makes every stored secret unreadable; re-seed if you do.
SECRET_ENCRYPTION_KEY=dev_secret_encryption_key_change_me

# ── Attachments ─────────────────────────────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./.data/attachments
MAX_ATTACHMENT_BYTES=26214400

# ── Widget ──────────────────────────────────────────────────
# The gateway serves the built widget bundle (no nginx locally).
WIDGET_DIST_PATH=./widget/dist

# ── Dev-only identity minting ───────────────────────────────
# Lets the demo page obtain an identity JWT without a host backend.
# In production the INTEGRATING PRODUCT mints these — see widget/INTEGRATION.md.
# Ignored entirely unless NODE_ENV=development.
DEV_IDENTITY_ENDPOINT=true

# ── AI foundation (Phase 1) ─────────────────────────────────────────
# The pipeline is:
#   ticket.created -> event_outbox -> AI dispatcher -> BullMQ ai.jobs
#   -> worker -> core /internal/ai -> ai-service -> core -> ai_execution
#
# ONE queue. `feature` distinguishes capabilities. See implementation.md.
AI_QUEUE_NAME=ai.jobs

# Kill switch. Off means no AI job is ever enqueued and ticketing is
# completely unaffected — AI must never be a dependency for raising a
# ticket. Default is OFF; turn it on deliberately.
AI_DISPATCH_ENABLED=false

# Watermark: only outbox rows created at/after this instant are eligible.
# FAILS CLOSED — unset means dispatch nothing. Without it, enabling the
# dispatcher would enqueue AI work for every historical ticket at once.
# Set it to "now" when you switch the pipeline on.
AI_DISPATCH_FROM=

# Python AI service. INTERNAL ONLY — never publicly bound, and it holds
# NO database credential of any kind (ADR-007). It refuses to boot if a
# *DATABASE_URL* is present in its environment.
AI_SERVICE_URL=http://localhost:5000

# ── Phase 3 Step 5 — abandoned-execution reaper ──────────────────────────
# Reconciles ai_execution rows stuck at 'running' because the worker crashed,
# the job stalled out, or a terminal report never reached Core. It NEVER
# re-enqueues: BullMQ stays the sole retry owner.
#
# Off by default. It is the only background loop that mutates business state,
# so it is enabled deliberately — and this is the kill switch if it misbehaves.
AI_REAPER_ENABLED=false

# Minutes a 'running' execution may sit before it is considered abandoned.
# Derived, not chosen: worst-case job lifetime is ~18 min (751s of retry delays
# at the +20% jitter ceiling, plus 6 x 20s HTTP budget, plus one stall
# recovery), and 45 gives 2.5x headroom. Values below 15 are refused at config
# load, because a shorter threshold can reap work that is still running.
AI_REAPER_STALE_MINUTES=45

# Phase 1 service authentication: the same shared-key pattern
# core-service already uses for x-internal-key. Phase 2 replaces this with
# the existing HMAC utilities in shared/hmac-utils.
AI_SERVICE_KEY=dev_ai_service_key_change_me

# Bound every outbound call — one hung request must not hold a worker slot.
CORE_TIMEOUT_MS=5000
AI_TIMEOUT_MS=10000

# Hard deadline for SIGTERM: stop taking jobs, give in-flight work this long,
# then exit. `worker.close()` waits for in-flight jobs FOREVER on its own, so
# without this the container is SIGKILLed mid-write instead. Sized against the
# termination grace period (podman-compose default 10s), not against the job —
# a worst-case attempt is ~20s, so a job caught mid-flight is left to BullMQ's
# stall recovery, which re-runs it idempotently.
AI_WORKER_DRAIN_MS=8000
AI_WORKER_CONCURRENCY=4

# ── Phase 2: service-to-service HMAC ────────────────────────────────
# Worker signs, Core verifies. Valid ONLY on /internal/ai/* — the worker
# holds no credential that works on /v1/* or /admin/api/*.
AI_WORKER_HMAC_SECRET=dev_ai_worker_hmac_secret_change_me

# Worker signs, Python verifies. Separate from the above on purpose:
# leaking the Python-facing secret must not grant access to Core.
AI_SERVICE_HMAC_SECRET=dev_ai_service_hmac_secret_change_me
